# =============================================
# BREACH INTEL - Konfigurasi API Keys
# =============================================
# Copy file ini menjadi .env dan isi API key kamu

PORT=3000

# HaveIBeenPwned - https://haveibeenpwned.com/API/Key
# $3.50/bulan, 30 hari trial gratis
HIBP_API_KEY=your_hibp_api_key_here

# LeakCheck - https://leakcheck.io/
# Free tier: 10 req/hari — untuk email, phone, name
LEAKCHECK_API_KEY=your_leakcheck_key_here

# EmailRep.io - https://emailrep.io/key
# Free tier tersedia
EMAILREP_API_KEY=your_emailrep_key_here

# Hunter.io - https://hunter.io/api
# Free: 25 req/bulan — untuk domain intelligence
HUNTER_API_KEY=your_hunter_key_here

# Shodan - https://account.shodan.io/
# Free membership tersedia — untuk port/CVE domain
SHODAN_API_KEY=your_shodan_key_here

# =============================================
# API BARU - PHONE INTELLIGENCE
# =============================================

# NumVerify - https://numverify.com/
# Free: 100 req/bulan — validasi nomor, operator, lokasi
NUMVERIFY_API_KEY=your_numverify_key_here

# AbstractAPI Phone Validation - https://www.abstractapi.com/phone-validation-api
# Free: 250 req/bulan — carrier, line type, timezone
ABSTRACTAPI_PHONE_KEY=your_abstractapi_phone_key_here
